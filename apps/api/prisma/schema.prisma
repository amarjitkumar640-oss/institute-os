generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum StaffRole {
  admin
  teacher
  frontdesk
}

enum StaffLoginMethod {
  phone
  email_username
}

enum BatchStatus {
  upcoming
  running
  completed
}

enum ApplicationStatus {
  pending
  rejected
  admitted
}

enum EnrollmentStatus {
  active
  paused
  completed
  dropped
}

enum LeadStatus {
  new
  contacted
  visited
  converted
  lost
}

// ── Fee system enums ──────────────────────────────────────────────────────────

enum TemplateLineType {
  fixed // Fixed rupee amount
  percentage // Percentage of effective fee
  equal_split // Split remaining equally across N installments
  remaining // Whatever is left unpaid
}

enum TemplateTrigger {
  on_admission // Due immediately on enrollment
  days_after_admission // Due X days after enrollment date
  days_after_previous // Due X days after previous installment due date
  monthly_recurring // Recurring on dayOfMonth each month
}

enum FeeScheduleStatus {
  active
  completed
  cancelled
}

enum InstallmentStatus {
  pending
  partial
  paid
  overdue
  waived
  deferred
}

enum TxnMode {
  cash
  upi
  card
  bank_transfer
  cheque
}

enum TxnType {
  payment
  refund
  adjustment
  credit_applied
}

// ── Class schedule enums ──────────────────────────────────────────────────────

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum SessionStatus {
  scheduled
  completed
  cancelled
}

enum SessionType {
  regular
  extra
  makeup
}

// ── Notification enums ──────────────────────────────────────────────────────────

enum NotificationType {
  session_cancelled
  session_rescheduled
  session_assigned
  session_subject_changed
  class_reminder
  new_enrollment
  installment_overdue
  batch_capacity
  new_application
}

// ── Tenant (top-level SaaS boundary — one row per institute) ──────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Branding — nullable; null means "use the default Institute-OS brand" in clients.
  brandPrimary     String?
  brandSecondary   String?
  brandAccent      String?
  brandBackground  String?
  brandHeaderBg    String?
  logoUrl          String?

  // Which identifier staff of this org log in with — admin-configurable.
  loginMethod StaffLoginMethod @default(email_username)

  // Notification tuning — admin-configurable, defaults work out of the box.
  classReminderMinutes Int @default(15)
  overdueGraceDays     Int @default(0)

  centers        Center[]
  staff          Staff[]
  courses        Course[]
  subjects       Subject[]
  examCategories ExamCategory[]
  documentTypes  DocumentType[]
  students       Student[]
  batches        Batch[]
  faculty        Faculty[]
  leads          Lead[]
  payments       PaymentTransaction[]
  notifications  Notification[]
  notificationRoutingRules NotificationRoutingRule[]
  admissionApplications    AdmissionApplication[]
  permissionGrants         PermissionGrant[]
  appReleases              AppRelease[]

  @@map("tenants")
}

// Tenant-scoped (unlike JobConfig/JobRun) — each tenant's mobile app is a
// distinct Android build (own package name), so release tracks are genuinely
// independent per tenant, not platform-wide.
model AppRelease {
  id          String   @id @default(uuid())
  tenantId    String
  platform    String   @default("android")
  versionName String
  versionCode Int
  s3Key       String
  changelog   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, platform, isActive, versionCode])
  @@map("app_releases")
}

// ── Core models ───────────────────────────────────────────────────────────────

model Center {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  staff    CenterStaff[]
  students Student[]
  batches  Batch[]
  faculty  Faculty[]
  leads    Lead[]
  admissionApplications AdmissionApplication[]

  @@map("centers")
}

model CenterStaff {
  id       String      @id @default(uuid())
  centerId String
  staffId  String
  // A staff member can hold more than one role at the same center at once
  // (e.g. admin + teacher) — always non-empty by application logic, never
  // validated as such at the DB level (see staff.routes.ts).
  roles    StaffRole[]

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([centerId, staffId])
  @@map("center_staff")
}

model Staff {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  fullName     String
  phone        String
  email        String    @unique
  username     String?
  // Bare S3 object key (not a URL) — same storage convention as
  // Student.photoUrl. Resolved to a short-lived signed URL at read time,
  // never stored/returned as a plain URL.
  photoUrl     String?
  // Tenant-level fallback roles, used when a staff member is in "all
  // centers" mode (no single CenterStaff row to read roles from).
  roles        StaffRole[]
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads     Lead[]               @relation("LeadAssignedTo")
  centerAssignments CenterStaff[]
  collectedPayments PaymentTransaction[]
  linkedFaculty     Faculty?
  notifications     Notification[]
  pushTokens        PushToken[]
  reviewedApplications AdmissionApplication[]
  markedSessionAttendances SessionAttendance[]
  markedFacultyAttendances FacultyAttendance[]
  jobRuns                  JobRun[]
  permissionGrantsUpdated  PermissionGrant[]
  passwordResetTokens      PasswordResetToken[]

  @@unique([tenantId, phone])
  @@unique([tenantId, username])
  @@map("staff")
}

// One row per forgot-password request. Only a hash of the code/token is ever
// stored (never the raw value) — same "never persist the real secret"
// convention as Staff.passwordHash. `channel` records whether this was
// delivered by email (long random token, ~1hr TTL) or SMS (short numeric
// code, ~15min TTL) — driven by the tenant's loginMethod at request time, see
// auth.service.ts's requestPasswordReset(). Single-use: consumed by setting
// usedAt, never deleted, so a reused/expired code has an audit trail.
model PasswordResetToken {
  id        String    @id @default(uuid())
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id])
  tokenHash String    @unique
  channel   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId])
  @@map("password_reset_tokens")
}

model Subject {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String

  examCategories  SubjectExamCategory[]
  facultySubjects FacultySubject[]
  classSlots      ClassSlot[]
  classSessions   ClassSession[]

  @@unique([tenantId, name])
  @@map("subjects")
}

// Many-to-many: a subject can be relevant to several exam categories, or none
// (empty = "Shared/General", applies across all categories).
model SubjectExamCategory {
  subjectId      String
  examCategoryId String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examCategory   ExamCategory @relation(fields: [examCategoryId], references: [id], onDelete: Cascade)

  @@id([subjectId, examCategoryId])
  @@map("subject_exam_categories")
}

model Faculty {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  employeeCode    String
  fullName        String
  phone           String
  email           String
  qualification   String
  experienceYears Int      @default(0)
  isActive        Boolean  @default(true)
  joiningDate     DateTime @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  centerId        String?
  center          Center?  @relation(fields: [centerId], references: [id])
  staffId         String?  @unique
  staff           Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  teachingSubjects FacultySubject[]
  classSlots       ClassSlot[]
  classSessions    ClassSession[]
  facultyAttendances FacultyAttendance[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@map("faculty")
}

model FacultySubject {
  facultyId String
  subjectId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([facultyId, subjectId])
  @@map("faculty_subjects")
}

model Course {
  id             String  @id @default(uuid())
  tenantId       String
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  name           String
  durationMonths Int
  defaultFee     Decimal @db.Decimal(10, 2)

  examCategories CourseExamCategory[]
  batches        Batch[]
  feeTemplate    CourseFeeTemplate?
  students       Student[]
  admissionApplications AdmissionApplication[]

  @@unique([tenantId, name])
  @@map("courses")
}

// Many-to-many: a course can span several exam categories, or none
// (empty = "General", applies across all categories).
model CourseExamCategory {
  courseId       String
  examCategoryId String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  examCategory   ExamCategory @relation(fields: [examCategoryId], references: [id], onDelete: Cascade)

  @@id([courseId, examCategoryId])
  @@map("course_exam_categories")
}

model Batch {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  courseId  String
  course    Course      @relation(fields: [courseId], references: [id])
  name      String
  capacity  Int
  startDate DateTime
  endDate   DateTime
  status    BatchStatus @default(upcoming)
  centerId  String?
  center    Center?     @relation(fields: [centerId], references: [id])

  enrollments   Enrollment[]
  classSlots    ClassSlot[]
  classSessions ClassSession[]

  @@map("batches")
}

model Student {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  studentCode        String
  centerId           String?
  center             Center?   @relation(fields: [centerId], references: [id])
  fullName           String
  phone              String
  email              String?
  photoUrl           String?
  dob                DateTime?
  address            String?
  guardianPhone      String?
  aadhaar            String?
  gender             String?
  fatherName         String?
  motherName         String?
  guardianOccupation String?
  guardianEmail      String?
  qualification      String?
  passYear           String?
  board              String?
  whatsapp           String?
  courseId           String?
  course             Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  coursePreference   String?
  durationPreference String?
  preferredTiming    String?
  paymentMode        String?
  amountPaid         Decimal?  @db.Decimal(10, 2)
  tcAcknowledgedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enrollments    Enrollment[]
  leadsConverted Lead[]            @relation("LeadConvertedStudent")
  documents      StudentDocument[]
  admissionApplication AdmissionApplication?
  sessionAttendances SessionAttendance[]

  @@unique([tenantId, studentCode])
  @@map("students")
}

model DocumentType {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  key       String
  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  documents StudentDocument[]

  @@unique([tenantId, key])
  @@map("document_types")
}

model ExamCategory {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  key       String
  label     String
  color     String  @default("#8B1E3F")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  subjectLinks SubjectExamCategory[]
  courseLinks  CourseExamCategory[]
  leads        Lead[]

  @@unique([tenantId, key])
  @@map("exam_categories")
}

model StudentDocument {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  fileUrl        String
  uploadedAt     DateTime     @default(now())

  @@unique([studentId, documentTypeId])
  @@map("student_documents")
}

model Enrollment {
  id         String           @id @default(uuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  batchId    String
  batch      Batch            @relation(fields: [batchId], references: [id])
  enrolledOn DateTime         @default(now())
  status     EnrollmentStatus @default(active)

  feeSchedule StudentFeeSchedule?

  @@unique([studentId, batchId])
  @@map("enrollments")
}

model Lead {
  id                 String       @id @default(uuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id])
  name               String
  phone              String
  targetExamId       String
  targetExam         ExamCategory @relation(fields: [targetExamId], references: [id])
  source             String
  status             LeadStatus   @default(new)
  assignedToId       String?
  assignedTo         Staff?       @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  convertedStudentId String?
  convertedStudent   Student?     @relation("LeadConvertedStudent", fields: [convertedStudentId], references: [id])
  notes              String?
  centerId           String?
  center             Center?      @relation(fields: [centerId], references: [id])
  createdAt          DateTime     @default(now())

  @@map("leads")
}

// Self-service admission form submissions — filled in by the prospective
// student themselves on the public site, not a Lead (an unqualified inquiry
// that may never admit). This is someone who already decided to apply.
// Frontdesk reviews each one and either rejects it (spam/duplicate/bad data)
// or carries it through the normal admit flow (POST /students/admit), which
// stamps `status: admitted` + `studentId` back onto this row.
model AdmissionApplication {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  fullName           String
  phone              String
  email              String?
  dob                DateTime?
  gender             String?
  address            String?
  fatherName         String?
  motherName         String?
  guardianPhone      String?
  guardianEmail      String?
  guardianOccupation String?
  qualification      String?
  passYear           String?
  board              String?
  courseId           String?
  course             Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  coursePreference   String?
  durationPreference String?
  whatsapp           String?
  // Student's preferred center — a preference frontdesk can still override
  // at admit time, not a binding assignment (mirrors coursePreference).
  centerId           String?
  center             Center?           @relation(fields: [centerId], references: [id], onDelete: SetNull)
  // The applicant's own acceptance of terms, captured at submission time —
  // distinct from Student.tcAcknowledgedAt, which is frontdesk confirming
  // (at admit time) that they informed the student of the terms.
  tcAcceptedAt       DateTime?
  status             ApplicationStatus @default(pending)
  rejectionReason    String?
  reviewedById       String?
  reviewedBy         Staff?            @relation(fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  studentId          String?           @unique
  student            Student?          @relation(fields: [studentId], references: [id])
  createdAt          DateTime          @default(now())

  @@map("admission_applications")
}

// ── Fee Template (course-level default plan) ──────────────────────────────────

model CourseFeeTemplate {
  id        String   @id @default(uuid())
  courseId  String   @unique
  course    Course   @relation(fields: [courseId], references: [id])
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines TemplateLine[]

  @@map("course_fee_templates")
}

model TemplateLine {
  id         String            @id @default(uuid())
  templateId String
  template   CourseFeeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder  Int
  label      String
  lineType   TemplateLineType  @default(fixed)
  amount     Decimal?          @db.Decimal(10, 2)
  percentage Decimal?          @db.Decimal(5, 2)
  splitCount Int?
  trigger    TemplateTrigger   @default(on_admission)
  offsetDays Int?
  dayOfMonth Int?

  @@map("template_lines")
}

// ── Student Fee Schedule (per-enrollment copy of template) ────────────────────

model StudentFeeSchedule {
  id             String            @id @default(uuid())
  enrollmentId   String            @unique
  enrollment     Enrollment        @relation(fields: [enrollmentId], references: [id])
  totalFee       Decimal           @db.Decimal(10, 2)
  discountAmount Decimal           @default(0) @db.Decimal(10, 2)
  discountReason String?
  effectiveFee   Decimal           @db.Decimal(10, 2)
  creditBalance  Decimal           @default(0) @db.Decimal(10, 2)
  status         FeeScheduleStatus @default(active)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  installments ScheduleInstallment[]
  transactions PaymentTransaction[]

  @@map("student_fee_schedules")
}

model ScheduleInstallment {
  id            String             @id @default(uuid())
  scheduleId    String
  schedule      StudentFeeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sortOrder     Int
  label         String
  plannedAmount Decimal            @db.Decimal(10, 2)
  paidAmount    Decimal            @default(0) @db.Decimal(10, 2)
  waivedAmount  Decimal            @default(0) @db.Decimal(10, 2)
  lateFee       Decimal            @default(0) @db.Decimal(10, 2)
  dueDate       DateTime           @db.Date
  status        InstallmentStatus  @default(pending)
  waivedReason  String?
  notes         String?
  overdueNotifiedAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  transactions PaymentTransaction[]

  @@map("schedule_installments")
}

// ── Payment Ledger (source of truth for every rupee) ─────────────────────────

model PaymentTransaction {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  scheduleId    String
  schedule      StudentFeeSchedule   @relation(fields: [scheduleId], references: [id])
  installmentId String?
  installment   ScheduleInstallment? @relation(fields: [installmentId], references: [id])
  amount        Decimal              @db.Decimal(10, 2)
  mode          TxnMode
  type          TxnType              @default(payment)
  receiptNo     String?
  paidAt        DateTime
  collectedById String?
  collectedBy   Staff?               @relation(fields: [collectedById], references: [id])
  chequeNo      String?
  bankName      String?
  upiRef        String?
  notes         String?
  createdAt     DateTime             @default(now())

  @@unique([tenantId, receiptNo])
  @@map("payment_transactions")
}

// ── Class Schedule ────────────────────────────────────────────────────────────

model ClassSlot {
  id        String    @id @default(uuid())
  batchId   String
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime String // "09:00" — 24-hour HH:MM
  endTime   String // "10:30"
  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  facultyId String?
  faculty   Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  room      String?
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessions ClassSession[]

  @@map("class_slots")
}

model ClassSession {
  id            String        @id @default(uuid())
  batchId       String
  batch         Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  slotId        String?
  slot          ClassSlot?    @relation(fields: [slotId], references: [id], onDelete: SetNull)
  scheduledDate DateTime      @db.Date
  startTime     String
  endTime       String
  subjectId     String?
  subject       Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  facultyId     String?
  faculty       Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  room          String?
  status        SessionStatus @default(scheduled)
  type          SessionType   @default(regular)
  cancelReason  String?
  notes         String?
  reminderSentAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  attendances SessionAttendance[]

  // Prevents generating the same slot twice on the same date.
  // NULL slotId (ad-hoc) is exempt: PostgreSQL treats NULLs as distinct in unique indexes.
  @@unique([slotId, scheduledDate])
  @@map("class_sessions")
}

// ── Notifications ──────────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  recipientId String
  recipient   Staff            @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  data        Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, readAt])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_tokens")
}

// Which roles receive a given notification type, per tenant — admin-configurable.
// No row for a (tenantId, type) pair means "use the built-in default" (see
// DEFAULT_ROUTING in notification.service.ts). An empty roles[] mutes it.
model NotificationRoutingRule {
  id       String           @id @default(uuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  type     NotificationType
  roles    StaffRole[]

  @@unique([tenantId, type])
  @@map("notification_routing_rules")
}

// ── Attendance ───────────────────────────────────────────────────────────────

enum AttendanceStatus {
  present
  absent
}

// Per-student, per-class-session mark — a student can attend one subject's
// session and skip another the same day, so this is scoped to the session,
// not the day.
model SessionAttendance {
  id             String           @id @default(uuid())
  classSessionId String
  classSession   ClassSession     @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         AttendanceStatus
  markedById     String?
  markedBy       Staff?           @relation(fields: [markedById], references: [id], onDelete: SetNull)
  markedAt       DateTime         @default(now())

  @@unique([classSessionId, studentId])
  @@map("session_attendance")
}

// Per-faculty, per-day mark — unlike students, faculty attendance isn't tied
// to a specific class (a teacher is "in" for the day, not per-session).
model FacultyAttendance {
  id         String           @id @default(uuid())
  facultyId  String
  faculty    Faculty          @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  markedById String?
  markedBy   Staff?           @relation(fields: [markedById], references: [id], onDelete: SetNull)
  markedAt   DateTime         @default(now())

  @@unique([facultyId, date])
  @@map("faculty_attendance")
}

// ── Background jobs ───────────────────────────────────────────────────────────
// Platform-wide, not tenant-scoped — a sweep like batch-status or class-reminder
// runs once across ALL tenants per tick, so a single run can't be attributed to
// one tenant. This is the second-ever exception to "every model is tenant-scoped"
// in this schema (the first is Tenant itself) — intentional, not an oversight.
// See apps/api/src/modules/jobs/registry.ts for the code-side job registry this
// pairs with (job label/description/handler live in code; only the admin-editable
// schedule and the run history live here).

enum JobRunStatus {
  running
  success
  failure
}

model JobConfig {
  id              String   @id @default(uuid())
  key             String   @unique
  intervalMinutes Int
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  runs JobRun[]

  @@map("job_configs")
}

model JobRun {
  id            String       @id @default(uuid())
  jobKey        String
  jobConfig     JobConfig    @relation(fields: [jobKey], references: [key])
  status        JobRunStatus @default(running)
  // "scheduler" | "manual" — TS union in registry.ts, not a DB enum (only ever
  // 2 values; a DB enum would need a migration to add a 3rd if that ever changes).
  trigger       String
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  errorMessage  String?
  resultSummary Json?
  triggeredById String?
  triggeredBy   Staff?       @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([jobKey, startedAt])
  @@map("job_runs")
}

// ── Access control ────────────────────────────────────────────────────────────
// Tenant-scoped (unlike JobConfig/JobRun above) — different institutes must be
// able to configure this differently. The set of valid screenKeys lives in
// apps/api/src/modules/permissions/registry.ts; a missing (tenant, role,
// screenKey) row means DENY, not "fall back to a default" — deliberately no
// runtime fallback, unlike NotificationRoutingRule's DEFAULT_ROUTING. Ownership
// scoping (a teacher only seeing their own batches/students/sessions) is a
// separate, untouched concern — this table governs whether a role can reach a
// screen at all, not which rows within it they see.
model PermissionGrant {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  role        StaffRole
  screenKey   String
  canRead     Boolean   @default(false)
  canWrite    Boolean   @default(false)
  canEdit     Boolean   @default(false)
  canDelete   Boolean   @default(false)
  updatedAt   DateTime  @updatedAt
  updatedById String?
  updatedBy   Staff?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, role, screenKey])
  @@map("permission_grants")
}

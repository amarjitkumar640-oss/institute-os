generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum StaffRole {
  admin
  teacher
  frontdesk
}

enum ExamCategory {
  ssc
  banking
  railway
  foundation
}

enum BatchStatus {
  upcoming
  running
  completed
}

enum EnrollmentStatus {
  active
  paused
  completed
  dropped
}

enum LeadStatus {
  new
  contacted
  visited
  converted
  lost
}

// ── Fee system enums ──────────────────────────────────────────────────────────

enum TemplateLineType {
  fixed          // Fixed rupee amount
  percentage     // Percentage of effective fee
  equal_split    // Split remaining equally across N installments
  remaining      // Whatever is left unpaid
}

enum TemplateTrigger {
  on_admission          // Due immediately on enrollment
  days_after_admission  // Due X days after enrollment date
  days_after_previous   // Due X days after previous installment due date
  monthly_recurring     // Recurring on dayOfMonth each month
}

enum FeeScheduleStatus {
  active
  completed
  cancelled
}

enum InstallmentStatus {
  pending
  partial
  paid
  overdue
  waived
  deferred
}

enum TxnMode {
  cash
  upi
  card
  bank_transfer
  cheque
}

enum TxnType {
  payment
  refund
  adjustment
  credit_applied
}

// ── Class schedule enums ──────────────────────────────────────────────────────

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum SessionStatus {
  scheduled
  completed
  cancelled
}

enum SessionType {
  regular
  extra
  makeup
}

// ── Core models ───────────────────────────────────────────────────────────────

model Center {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  staff    CenterStaff[]
  students Student[]
  batches  Batch[]
  faculty  Faculty[]
  leads    Lead[]

  @@map("centers")
}

model CenterStaff {
  id       String    @id @default(uuid())
  centerId String
  staffId  String
  role     StaffRole

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([centerId, staffId])
  @@map("center_staff")
}

model Staff {
  id           String    @id @default(uuid())
  fullName     String
  phone        String
  email        String    @unique
  role         StaffRole
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads        Lead[]               @relation("LeadAssignedTo")
  centerAssignments    CenterStaff[]
  collectedPayments    PaymentTransaction[]

  @@map("staff")
}

model Subject {
  id           String        @id @default(uuid())
  name         String        @unique
  examCategory ExamCategory?

  facultySubjects FacultySubject[]
  classSlots      ClassSlot[]
  classSessions   ClassSession[]

  @@map("subjects")
}

model Faculty {
  id              String    @id @default(uuid())
  employeeCode    String    @unique
  fullName        String
  phone           String    @unique
  email           String    @unique
  qualification   String
  experienceYears Int       @default(0)
  isActive        Boolean   @default(true)
  joiningDate     DateTime  @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  centerId        String?
  center          Center?   @relation(fields: [centerId], references: [id])

  teachingSubjects FacultySubject[]
  classSlots       ClassSlot[]
  classSessions    ClassSession[]

  @@map("faculty")
}

model FacultySubject {
  facultyId String
  subjectId String
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([facultyId, subjectId])
  @@map("faculty_subjects")
}

model Course {
  id             String       @id @default(uuid())
  name           String
  examCategory   ExamCategory
  durationMonths Int
  defaultFee     Decimal      @db.Decimal(10, 2)

  batches     Batch[]
  feeTemplate CourseFeeTemplate?

  @@map("courses")
}

model Batch {
  id        String      @id @default(uuid())
  courseId  String
  course    Course      @relation(fields: [courseId], references: [id])
  name      String
  capacity  Int
  startDate DateTime
  endDate   DateTime
  status    BatchStatus @default(upcoming)
  centerId  String?
  center    Center?     @relation(fields: [centerId], references: [id])

  enrollments   Enrollment[]
  classSlots    ClassSlot[]
  classSessions ClassSession[]

  @@map("batches")
}

model Student {
  id                 String    @id @default(uuid())
  studentCode        String    @unique
  centerId           String?
  center             Center?   @relation(fields: [centerId], references: [id])
  fullName           String
  phone              String
  email              String?
  photoUrl           String?
  dob                DateTime?
  address            String?
  guardianPhone      String?
  aadhaar            String?
  gender             String?
  fatherName         String?
  motherName         String?
  guardianOccupation String?
  guardianEmail      String?
  qualification      String?
  passYear           String?
  board              String?
  whatsapp           String?
  coursePreference   String?
  durationPreference String?
  preferredTiming    String?
  paymentMode        String?
  amountPaid         Decimal?  @db.Decimal(10, 2)
  tcAcknowledgedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enrollments    Enrollment[]
  leadsConverted Lead[]       @relation("LeadConvertedStudent")

  @@map("students")
}

model Enrollment {
  id         String           @id @default(uuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  batchId    String
  batch      Batch            @relation(fields: [batchId], references: [id])
  enrolledOn DateTime         @default(now())
  status     EnrollmentStatus @default(active)

  feeSchedule StudentFeeSchedule?

  @@unique([studentId, batchId])
  @@map("enrollments")
}

model Lead {
  id                 String       @id @default(uuid())
  name               String
  phone              String
  targetExam         ExamCategory
  source             String
  status             LeadStatus   @default(new)
  assignedToId       String?
  assignedTo         Staff?       @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  convertedStudentId String?
  convertedStudent   Student?     @relation("LeadConvertedStudent", fields: [convertedStudentId], references: [id])
  notes              String?
  centerId           String?
  center             Center?      @relation(fields: [centerId], references: [id])
  createdAt          DateTime     @default(now())

  @@map("leads")
}

// ── Fee Template (course-level default plan) ──────────────────────────────────

model CourseFeeTemplate {
  id        String   @id @default(uuid())
  courseId  String   @unique
  course    Course   @relation(fields: [courseId], references: [id])
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines TemplateLine[]

  @@map("course_fee_templates")
}

model TemplateLine {
  id         String            @id @default(uuid())
  templateId String
  template   CourseFeeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder  Int
  label      String
  lineType   TemplateLineType  @default(fixed)
  amount     Decimal?          @db.Decimal(10, 2)
  percentage Decimal?          @db.Decimal(5, 2)
  splitCount Int?
  trigger    TemplateTrigger   @default(on_admission)
  offsetDays Int?
  dayOfMonth Int?

  @@map("template_lines")
}

// ── Student Fee Schedule (per-enrollment copy of template) ────────────────────

model StudentFeeSchedule {
  id             String            @id @default(uuid())
  enrollmentId   String            @unique
  enrollment     Enrollment        @relation(fields: [enrollmentId], references: [id])
  totalFee       Decimal           @db.Decimal(10, 2)
  discountAmount Decimal           @default(0) @db.Decimal(10, 2)
  discountReason String?
  effectiveFee   Decimal           @db.Decimal(10, 2)
  creditBalance  Decimal           @default(0) @db.Decimal(10, 2)
  status         FeeScheduleStatus @default(active)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  installments ScheduleInstallment[]
  transactions PaymentTransaction[]

  @@map("student_fee_schedules")
}

model ScheduleInstallment {
  id            String             @id @default(uuid())
  scheduleId    String
  schedule      StudentFeeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sortOrder     Int
  label         String
  plannedAmount Decimal            @db.Decimal(10, 2)
  paidAmount    Decimal            @default(0) @db.Decimal(10, 2)
  waivedAmount  Decimal            @default(0) @db.Decimal(10, 2)
  lateFee       Decimal            @default(0) @db.Decimal(10, 2)
  dueDate       DateTime           @db.Date
  status        InstallmentStatus  @default(pending)
  waivedReason  String?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  transactions PaymentTransaction[]

  @@map("schedule_installments")
}

// ── Payment Ledger (source of truth for every rupee) ─────────────────────────

model PaymentTransaction {
  id            String               @id @default(uuid())
  scheduleId    String
  schedule      StudentFeeSchedule   @relation(fields: [scheduleId], references: [id])
  installmentId String?
  installment   ScheduleInstallment? @relation(fields: [installmentId], references: [id])
  amount        Decimal              @db.Decimal(10, 2)
  mode          TxnMode
  type          TxnType              @default(payment)
  receiptNo     String?              @unique
  paidAt        DateTime
  collectedById String?
  collectedBy   Staff?               @relation(fields: [collectedById], references: [id])
  chequeNo      String?
  bankName      String?
  upiRef        String?
  notes         String?
  createdAt     DateTime             @default(now())

  @@map("payment_transactions")
}

// ── Class Schedule ────────────────────────────────────────────────────────────

model ClassSlot {
  id        String    @id @default(uuid())
  batchId   String
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime String    // "09:00" — 24-hour HH:MM
  endTime   String    // "10:30"
  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  facultyId String?
  faculty   Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  room      String?
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessions ClassSession[]

  @@map("class_slots")
}

model ClassSession {
  id            String        @id @default(uuid())
  batchId       String
  batch         Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  slotId        String?
  slot          ClassSlot?    @relation(fields: [slotId], references: [id], onDelete: SetNull)
  scheduledDate DateTime      @db.Date
  startTime     String
  endTime       String
  subjectId     String?
  subject       Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  facultyId     String?
  faculty       Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  room          String?
  status        SessionStatus @default(scheduled)
  type          SessionType   @default(regular)
  cancelReason  String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Prevents generating the same slot twice on the same date.
  // NULL slotId (ad-hoc) is exempt: PostgreSQL treats NULLs as distinct in unique indexes.
  @@unique([slotId, scheduledDate])
  @@map("class_sessions")
}

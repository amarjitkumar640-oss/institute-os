generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum StaffRole {
  admin
  teacher
  frontdesk
}

enum StaffLoginMethod {
  phone
  email_username
}

enum BatchStatus {
  upcoming
  running
  completed
  // Every active enrollment was merged into another batch (see
  // mergeBatch() in modules/batches/batch-merge.service.ts) — distinct
  // from `completed`, which means the batch actually ran its course to
  // the end. Kept around (not deleted) as a historical record even
  // though it now has no active students.
  merged
}

enum ApplicationStatus {
  pending
  rejected
  admitted
}

enum EnrollmentStatus {
  active
  paused
  completed
  dropped
}

enum LeadStatus {
  new
  contacted
  visited
  converted
  lost
}

// ── Fee system enums ──────────────────────────────────────────────────────────

enum TemplateLineType {
  fixed // Fixed rupee amount
  percentage // Percentage of effective fee
  equal_split // Split remaining equally across N installments
  remaining // Whatever is left unpaid
}

enum TemplateTrigger {
  on_admission // Due immediately on enrollment
  days_after_admission // Due X days after enrollment date
  days_after_previous // Due X days after previous installment due date
  monthly_recurring // Recurring on dayOfMonth each month
}

enum FeeScheduleStatus {
  active
  completed
  cancelled
}

enum InstallmentStatus {
  pending
  partial
  paid
  overdue
  waived
  deferred
}

enum TxnMode {
  cash
  upi
  card
  bank_transfer
  cheque
}

enum TxnType {
  payment
  refund
  adjustment
  credit_applied
}

// ── Class schedule enums ──────────────────────────────────────────────────────

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum SessionStatus {
  scheduled
  completed
  cancelled
}

enum SessionType {
  regular
  extra
  makeup
}

// ── Notification enums ──────────────────────────────────────────────────────────

enum NotificationType {
  session_cancelled
  session_rescheduled
  session_assigned
  session_subject_changed
  class_reminder
  new_enrollment
  installment_overdue
  batch_capacity
  new_application
}

// ── Public marketing site content ───────────────────────────────────────────────
// Backs a small, separate content system (see apps/api/src/modules/site) for the
// standalone marketing site — deliberately NOT the same thing as the operational
// app above. One shared shape covers all three post types since they're all
// "something the owner posts and updates periodically," rather than three
// separate one-off tables.
enum SiteContentType {
  announcement
  result
  gallery
}

// ── Tenant (top-level SaaS boundary — one row per institute) ──────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Branding — nullable; null means "use the default Institute-OS brand" in clients.
  brandPrimary     String?
  brandSecondary   String?
  brandAccent      String?
  brandBackground  String?
  brandHeaderBg    String?
  logoUrl          String?

  // Which identifier staff of this org log in with — admin-configurable.
  loginMethod StaffLoginMethod @default(email_username)

  // Notification tuning — admin-configurable, defaults work out of the box.
  classReminderMinutes Int @default(15)
  overdueGraceDays     Int @default(0)

  // Legal/billing details — needed to generate a compliant invoice for a
  // corporate sponsor (SponsorInvoice), which must show the *seller's* own
  // GSTIN/address, not just the buyer's. Nullable: most tenants never issue
  // an invoice and don't need to fill this in.
  legalName         String?
  registeredAddress String?
  gstin             String?
  stateCode         String? // 2-digit GST state code, e.g. "27" for Maharashtra
  bankDetails       String?
  // Sequential invoice numbering — incremented atomically inside the same
  // transaction as SponsorInvoice creation (see invoice.service.ts). Unlike
  // generateReceiptNo() (timestamp+random, fine for internal receipts), an
  // invoice is a legal document and needs real sequential numbers.
  nextInvoiceSeq Int @default(1)

  centers        Center[]
  staff          Staff[]
  courses        Course[]
  subjects       Subject[]
  examCategories ExamCategory[]
  documentTypes  DocumentType[]
  students       Student[]
  batches        Batch[]
  faculty        Faculty[]
  leads          Lead[]
  payments       PaymentTransaction[]
  notifications  Notification[]
  notificationRoutingRules NotificationRoutingRule[]
  admissionApplications    AdmissionApplication[]
  permissionGrants         PermissionGrant[]
  appReleases              AppRelease[]
  siteHighlights           SiteHighlight[]
  aiAssistantSessions      AiAssistantSession[]
  batchDiscountOffers      BatchDiscountOffer[]
  sponsors                 Sponsor[]
  sponsorshipContracts     SponsorshipContract[]

  @@map("tenants")
}

// One row per posted announcement / result / gallery photo on the standalone
// marketing site. `meta` carries type-specific extras (e.g. a result's exam
// name + rank/score) without needing separate tables per type — the site's
// admin page and public feed both just filter by `type`.
model SiteHighlight {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  type        SiteContentType
  title       String
  description String?
  imageUrl    String?
  meta        Json?
  isActive    Boolean          @default(true)
  publishedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId, type, isActive, publishedAt])
  @@map("site_highlights")
}

// Tenant-scoped (unlike JobConfig/JobRun) — each tenant's mobile app is a
// distinct Android build (own package name), so release tracks are genuinely
// independent per tenant, not platform-wide.
model AppRelease {
  id          String   @id @default(uuid())
  tenantId    String
  platform    String   @default("android")
  versionName String
  versionCode Int
  s3Key       String
  changelog   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, platform, isActive, versionCode])
  @@map("app_releases")
}

// ── Core models ───────────────────────────────────────────────────────────────

model Center {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  staff    CenterStaff[]
  students Student[]
  batches  Batch[]
  faculty  Faculty[]
  leads    Lead[]
  admissionApplications AdmissionApplication[]

  @@map("centers")
}

model CenterStaff {
  id       String      @id @default(uuid())
  centerId String
  staffId  String
  // A staff member can hold more than one role at the same center at once
  // (e.g. admin + teacher) — always non-empty by application logic, never
  // validated as such at the DB level (see staff.routes.ts).
  roles    StaffRole[]

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([centerId, staffId])
  @@map("center_staff")
}

model Staff {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  fullName     String
  phone        String
  email        String    @unique
  username     String?
  // Bare S3 object key (not a URL) — same storage convention as
  // Student.photoUrl. Resolved to a short-lived signed URL at read time,
  // never stored/returned as a plain URL.
  photoUrl     String?
  // Tenant-level fallback roles, used when a staff member is in "all
  // centers" mode (no single CenterStaff row to read roles from).
  roles        StaffRole[]
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads     Lead[]               @relation("LeadAssignedTo")
  centerAssignments CenterStaff[]
  collectedPayments PaymentTransaction[]
  linkedFaculty     Faculty?
  notifications     Notification[]
  pushTokens        PushToken[]
  reviewedApplications AdmissionApplication[]
  markedSessionAttendances SessionAttendance[]
  markedFacultyAttendances FacultyAttendance[]
  jobRuns                  JobRun[]
  permissionGrantsUpdated  PermissionGrant[]
  passwordResetTokens      PasswordResetToken[]
  aiAssistantSessions      AiAssistantSession[]

  @@unique([tenantId, phone])
  @@unique([tenantId, username])
  @@map("staff")
}

// One row per forgot-password request. Only a hash of the code/token is ever
// stored (never the raw value) — same "never persist the real secret"
// convention as Staff.passwordHash. `channel` records whether this was
// delivered by email (long random token, ~1hr TTL) or SMS (short numeric
// code, ~15min TTL) — driven by the tenant's loginMethod at request time, see
// auth.service.ts's requestPasswordReset(). Single-use: consumed by setting
// usedAt, never deleted, so a reused/expired code has an audit trail.
model PasswordResetToken {
  id        String    @id @default(uuid())
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id])
  tokenHash String    @unique
  channel   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId])
  @@map("password_reset_tokens")
}

model Subject {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String

  examCategories  SubjectExamCategory[]
  facultySubjects FacultySubject[]
  classSlots      ClassSlot[]
  classSessions   ClassSession[]

  @@unique([tenantId, name])
  @@map("subjects")
}

// Many-to-many: a subject can be relevant to several exam categories, or none
// (empty = "Shared/General", applies across all categories).
model SubjectExamCategory {
  subjectId      String
  examCategoryId String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examCategory   ExamCategory @relation(fields: [examCategoryId], references: [id], onDelete: Cascade)

  @@id([subjectId, examCategoryId])
  @@map("subject_exam_categories")
}

model Faculty {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  employeeCode    String
  fullName        String
  phone           String
  email           String
  qualification   String
  experienceYears Int      @default(0)
  isActive        Boolean  @default(true)
  joiningDate     DateTime @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  centerId        String?
  center          Center?  @relation(fields: [centerId], references: [id])
  staffId         String?  @unique
  staff           Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  teachingSubjects FacultySubject[]
  classSlots       ClassSlot[]
  classSessions    ClassSession[]
  facultyAttendances FacultyAttendance[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@map("faculty")
}

model FacultySubject {
  facultyId String
  subjectId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([facultyId, subjectId])
  @@map("faculty_subjects")
}

model Course {
  id             String  @id @default(uuid())
  tenantId       String
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  name           String
  durationMonths Int
  defaultFee     Decimal @db.Decimal(10, 2)
  // A standing discount auto-applied to every new enrollment in this course
  // (fed into generateSchedule's discountAmount at admission time — see
  // students.routes.ts). Distinct from StudentFeeSchedule.discountAmount,
  // which is a one-off per-student override applied after enrollment.
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  discountReason String?
  // A course that's never billed to students at all (e.g. a dedicated CSR
  // program course) — admission into any batch under it skips fee-schedule
  // generation entirely. Distinct from a CSR-sponsored *batch* under an
  // otherwise-normal course, which is represented by SponsorshipContract
  // instead (see students.routes.ts's /admit handler for both checks).
  isFree Boolean @default(false)

  examCategories CourseExamCategory[]
  batches        Batch[]
  feeTemplate    CourseFeeTemplate?
  students       Student[]
  admissionApplications AdmissionApplication[]

  @@unique([tenantId, name])
  @@map("courses")
}

// Many-to-many: a course can span several exam categories, or none
// (empty = "General", applies across all categories).
model CourseExamCategory {
  courseId       String
  examCategoryId String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  examCategory   ExamCategory @relation(fields: [examCategoryId], references: [id], onDelete: Cascade)

  @@id([courseId, examCategoryId])
  @@map("course_exam_categories")
}

model Batch {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  courseId  String
  course    Course      @relation(fields: [courseId], references: [id])
  name      String
  capacity  Int
  startDate DateTime
  endDate   DateTime
  status    BatchStatus @default(upcoming)
  centerId  String?
  center    Center?     @relation(fields: [centerId], references: [id])

  enrollments   Enrollment[]
  classSlots    ClassSlot[]
  classSessions ClassSession[]
  discountOffers BatchDiscountOffer[]
  sponsorshipContract SponsorshipContract?

  @@map("batches")
}

// "First N students in this batch get ₹X off" — admin picks exactly one
// batch per offer (not every batch of a course; a deliberately narrower,
// more manageable scope than Course.discountAmount's blanket standing
// discount). Redemption is checked+incremented atomically inside the same
// transaction as admission (students.routes.ts), mirroring the existing
// batch-capacity check in enrollments.service.ts — read current count,
// compare, act, all inside one transaction.
model BatchDiscountOffer {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  batchId        String
  batch          Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  discountAmount Decimal  @db.Decimal(10, 2)
  maxRedemptions Int
  redeemedCount  Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("batch_discount_offers")
}

// ── CSR sponsorship ──────────────────────────────────────────────────────────
// A company sponsors one specific batch in full (never a mix of sponsored and
// self-paying students in the same batch — see students.routes.ts's /admit
// handler, which skips fee-schedule generation entirely for every admission
// into a batch that has an active SponsorshipContract). The institute still
// gets paid, just by the sponsor instead of the students, tracked via
// SponsorPaymentMilestone and invoiced via SponsorInvoice.

model Sponsor {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstin         String?
  stateCode     String? // compared against Tenant.stateCode to decide CGST+SGST vs IGST
  notes         String?
  contracts     SponsorshipContract[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sponsors")
}

// One contract per batch (batchId is unique) — mirrors BatchDiscountOffer's
// "one offer per batch, not per course" precedent. contractedStudentCount is
// informational (shown on the invoice / admin UI); the batch is always fully
// sponsored, so Batch.capacity — already enforced by createEnrollment's
// existing active-enrollment count (enrollments.service.ts) — is what
// actually caps admissions. No separate capacity-enforcement path needed.
model SponsorshipContract {
  id                     String    @id @default(uuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id])
  sponsorId              String
  sponsor                Sponsor   @relation(fields: [sponsorId], references: [id])
  batchId                String    @unique
  batch                  Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  contractedStudentCount Int
  totalContractAmount    Decimal   @db.Decimal(12, 2)
  // null = GST-exempt for this contract's invoices. When set, invoice.service.ts
  // splits it CGST+SGST (sponsor and tenant same stateCode) or IGST (different).
  gstRate                Decimal?  @db.Decimal(5, 2)
  startDate              DateTime
  endDate                DateTime?
  status                 String    @default("active") // active | completed | cancelled
  documentUrl            String?   // S3 key — uploaded signed agreement
  notes                  String?
  milestones             SponsorPaymentMilestone[]
  invoices               SponsorInvoice[]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("sponsorship_contracts")
}

// How the institute actually gets paid by the sponsor — one or more line
// items (e.g. "Advance" + "On completion"), each invoiced independently via
// SponsorInvoice once marked ready. A single lump-sum contract is just one
// milestone.
model SponsorPaymentMilestone {
  id             String              @id @default(uuid())
  contractId     String
  contract       SponsorshipContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  label          String
  amount         Decimal             @db.Decimal(12, 2)
  dueDate        DateTime?
  status         String              @default("pending") // pending | received
  receivedAt     DateTime?
  receivedAmount Decimal?            @db.Decimal(12, 2)
  notes          String?
  invoice        SponsorInvoice?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@map("sponsor_payment_milestones")
}

// One invoice per milestone (milestoneId is unique — v1 doesn't support
// voiding/reissuing). shareToken is a random, unguessable public lookup key
// (see sponsors.public.routes.ts) — deliberately not the invoice's own id,
// so a leaked/guessed row id can't be used to fetch someone else's invoice.
model SponsorInvoice {
  id              String                  @id @default(uuid())
  tenantId        String
  contractId      String
  contract        SponsorshipContract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestoneId     String                  @unique
  milestone       SponsorPaymentMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  invoiceNumber   String                  @unique
  issueDate       DateTime
  taxableAmount   Decimal                 @db.Decimal(12, 2)
  gstRate         Decimal?                @db.Decimal(5, 2)
  cgstAmount      Decimal                 @default(0) @db.Decimal(12, 2)
  sgstAmount      Decimal                 @default(0) @db.Decimal(12, 2)
  igstAmount      Decimal                 @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal                 @db.Decimal(12, 2)
  pdfS3Key        String
  shareToken      String                  @unique
  createdAt       DateTime                @default(now())

  @@map("sponsor_invoices")
}

model Student {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  studentCode        String
  // Pre-system paper-register reference number (e.g. a legacy admission
  // book serial) for students backfilled from historical records — never
  // generated or validated by this app, purely a display reference back to
  // the physical record it was transcribed from.
  legacyId           String?
  centerId           String?
  center             Center?   @relation(fields: [centerId], references: [id])
  fullName           String
  phone              String
  email              String?
  photoUrl           String?
  dob                DateTime?
  address            String?
  guardianPhone      String?
  aadhaar            String?
  gender             String?
  fatherName         String?
  motherName         String?
  guardianOccupation String?
  guardianEmail      String?
  qualification      String?
  passYear           String?
  board              String?
  whatsapp           String?
  courseId           String?
  course             Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  coursePreference   String?
  durationPreference String?
  preferredTiming    String?
  paymentMode        String?
  amountPaid         Decimal?  @db.Decimal(10, 2)
  tcAcknowledgedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enrollments    Enrollment[]
  leadsConverted Lead[]            @relation("LeadConvertedStudent")
  documents      StudentDocument[]
  admissionApplication AdmissionApplication?
  sessionAttendances SessionAttendance[]

  @@unique([tenantId, studentCode])
  // NULLs (a student admitted normally, never in a paper register) don't
  // collide with each other or with anything else under Postgres unique-
  // index semantics — this only rejects two non-null legacyIds colliding
  // within the same tenant.
  @@unique([tenantId, legacyId])
  @@map("students")
}

model DocumentType {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  key       String
  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  documents StudentDocument[]

  @@unique([tenantId, key])
  @@map("document_types")
}

model ExamCategory {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  key       String
  label     String
  color     String  @default("#8B1E3F")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  subjectLinks SubjectExamCategory[]
  courseLinks  CourseExamCategory[]
  leads        Lead[]

  @@unique([tenantId, key])
  @@map("exam_categories")
}

model StudentDocument {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  fileUrl        String
  uploadedAt     DateTime     @default(now())

  @@unique([studentId, documentTypeId])
  @@map("student_documents")
}

model Enrollment {
  id         String           @id @default(uuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  batchId    String
  batch      Batch            @relation(fields: [batchId], references: [id])
  enrolledOn DateTime         @default(now())
  status     EnrollmentStatus @default(active)

  feeSchedule StudentFeeSchedule?

  @@unique([studentId, batchId])
  @@map("enrollments")
}

model Lead {
  id                 String       @id @default(uuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id])
  name               String
  phone              String
  targetExamId       String
  targetExam         ExamCategory @relation(fields: [targetExamId], references: [id])
  source             String
  status             LeadStatus   @default(new)
  assignedToId       String?
  assignedTo         Staff?       @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  convertedStudentId String?
  convertedStudent   Student?     @relation("LeadConvertedStudent", fields: [convertedStudentId], references: [id])
  notes              String?
  centerId           String?
  center             Center?      @relation(fields: [centerId], references: [id])
  createdAt          DateTime     @default(now())

  @@map("leads")
}

// Self-service admission form submissions — filled in by the prospective
// student themselves on the public site, not a Lead (an unqualified inquiry
// that may never admit). This is someone who already decided to apply.
// Frontdesk reviews each one and either rejects it (spam/duplicate/bad data)
// or carries it through the normal admit flow (POST /students/admit), which
// stamps `status: admitted` + `studentId` back onto this row.
model AdmissionApplication {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  fullName           String
  phone              String
  email              String?
  dob                DateTime?
  gender             String?
  address            String?
  fatherName         String?
  motherName         String?
  guardianPhone      String?
  guardianEmail      String?
  guardianOccupation String?
  qualification      String?
  passYear           String?
  board              String?
  courseId           String?
  course             Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  coursePreference   String?
  durationPreference String?
  whatsapp           String?
  // Student's preferred center — a preference frontdesk can still override
  // at admit time, not a binding assignment (mirrors coursePreference).
  centerId           String?
  center             Center?           @relation(fields: [centerId], references: [id], onDelete: SetNull)
  // The applicant's own acceptance of terms, captured at submission time —
  // distinct from Student.tcAcknowledgedAt, which is frontdesk confirming
  // (at admit time) that they informed the student of the terms.
  tcAcceptedAt       DateTime?
  status             ApplicationStatus @default(pending)
  rejectionReason    String?
  reviewedById       String?
  reviewedBy         Staff?            @relation(fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  studentId          String?           @unique
  student            Student?          @relation(fields: [studentId], references: [id])
  createdAt          DateTime          @default(now())

  @@map("admission_applications")
}

// ── Fee Template (course-level default plan) ──────────────────────────────────

model CourseFeeTemplate {
  id        String   @id @default(uuid())
  courseId  String   @unique
  course    Course   @relation(fields: [courseId], references: [id])
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines TemplateLine[]

  @@map("course_fee_templates")
}

model TemplateLine {
  id         String            @id @default(uuid())
  templateId String
  template   CourseFeeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder  Int
  label      String
  lineType   TemplateLineType  @default(fixed)
  amount     Decimal?          @db.Decimal(10, 2)
  percentage Decimal?          @db.Decimal(5, 2)
  splitCount Int?
  trigger    TemplateTrigger   @default(on_admission)
  offsetDays Int?
  dayOfMonth Int?

  @@map("template_lines")
}

// ── Student Fee Schedule (per-enrollment copy of template) ────────────────────

model StudentFeeSchedule {
  id             String            @id @default(uuid())
  enrollmentId   String            @unique
  enrollment     Enrollment        @relation(fields: [enrollmentId], references: [id])
  totalFee       Decimal           @db.Decimal(10, 2)
  discountAmount Decimal           @default(0) @db.Decimal(10, 2)
  discountReason String?
  effectiveFee   Decimal           @db.Decimal(10, 2)
  creditBalance  Decimal           @default(0) @db.Decimal(10, 2)
  status         FeeScheduleStatus @default(active)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  installments ScheduleInstallment[]
  transactions PaymentTransaction[]

  @@map("student_fee_schedules")
}

model ScheduleInstallment {
  id            String             @id @default(uuid())
  scheduleId    String
  schedule      StudentFeeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sortOrder     Int
  label         String
  plannedAmount Decimal            @db.Decimal(10, 2)
  paidAmount    Decimal            @default(0) @db.Decimal(10, 2)
  waivedAmount  Decimal            @default(0) @db.Decimal(10, 2)
  lateFee       Decimal            @default(0) @db.Decimal(10, 2)
  dueDate       DateTime           @db.Date
  status        InstallmentStatus  @default(pending)
  waivedReason  String?
  notes         String?
  overdueNotifiedAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  transactions PaymentTransaction[]

  @@map("schedule_installments")
}

// ── Payment Ledger (source of truth for every rupee) ─────────────────────────

model PaymentTransaction {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  scheduleId    String
  schedule      StudentFeeSchedule   @relation(fields: [scheduleId], references: [id])
  installmentId String?
  installment   ScheduleInstallment? @relation(fields: [installmentId], references: [id])
  amount        Decimal              @db.Decimal(10, 2)
  mode          TxnMode
  type          TxnType              @default(payment)
  receiptNo     String?
  paidAt        DateTime
  collectedById String?
  collectedBy   Staff?               @relation(fields: [collectedById], references: [id])
  chequeNo      String?
  bankName      String?
  upiRef        String?
  notes         String?
  // Pre-system paper-register receipt number, for payments backfilled via
  // the legacy student import (see Student.legacyId's own comment — same
  // idea, same rule: never generated or validated by this app, purely a
  // display reference back to the physical receipt it was transcribed
  // from. `receiptNo` above is always this app's own auto-generated one,
  // even for a backfilled payment — this field is what preserves the
  // paper trail without needing it to be unique.
  legacyReceiptNo String?
  createdAt     DateTime             @default(now())

  @@unique([tenantId, receiptNo])
  @@map("payment_transactions")
}

// ── Class Schedule ────────────────────────────────────────────────────────────

model ClassSlot {
  id        String    @id @default(uuid())
  batchId   String
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime String // "09:00" — 24-hour HH:MM
  endTime   String // "10:30"
  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  facultyId String?
  faculty   Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  room      String?
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessions ClassSession[]

  @@map("class_slots")
}

model ClassSession {
  id            String        @id @default(uuid())
  batchId       String
  batch         Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  slotId        String?
  slot          ClassSlot?    @relation(fields: [slotId], references: [id], onDelete: SetNull)
  scheduledDate DateTime      @db.Date
  startTime     String
  endTime       String
  subjectId     String?
  subject       Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  facultyId     String?
  faculty       Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  room          String?
  status        SessionStatus @default(scheduled)
  type          SessionType   @default(regular)
  cancelReason  String?
  notes         String?
  reminderSentAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  attendances SessionAttendance[]

  // Prevents generating the same slot twice on the same date.
  // NULL slotId (ad-hoc) is exempt: PostgreSQL treats NULLs as distinct in unique indexes.
  @@unique([slotId, scheduledDate])
  @@map("class_sessions")
}

// ── Notifications ──────────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  recipientId String
  recipient   Staff            @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  data        Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, readAt])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_tokens")
}

// Which roles receive a given notification type, per tenant — admin-configurable.
// No row for a (tenantId, type) pair means "use the built-in default" (see
// DEFAULT_ROUTING in notification.service.ts). An empty roles[] mutes it.
model NotificationRoutingRule {
  id       String           @id @default(uuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  type     NotificationType
  roles    StaffRole[]

  @@unique([tenantId, type])
  @@map("notification_routing_rules")
}

// ── Attendance ───────────────────────────────────────────────────────────────

enum AttendanceStatus {
  present
  absent
}

// Per-student, per-class-session mark — a student can attend one subject's
// session and skip another the same day, so this is scoped to the session,
// not the day.
model SessionAttendance {
  id             String           @id @default(uuid())
  classSessionId String
  classSession   ClassSession     @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         AttendanceStatus
  markedById     String?
  markedBy       Staff?           @relation(fields: [markedById], references: [id], onDelete: SetNull)
  markedAt       DateTime         @default(now())

  @@unique([classSessionId, studentId])
  @@map("session_attendance")
}

// Per-faculty, per-day mark — unlike students, faculty attendance isn't tied
// to a specific class (a teacher is "in" for the day, not per-session).
model FacultyAttendance {
  id         String           @id @default(uuid())
  facultyId  String
  faculty    Faculty          @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  markedById String?
  markedBy   Staff?           @relation(fields: [markedById], references: [id], onDelete: SetNull)
  markedAt   DateTime         @default(now())

  @@unique([facultyId, date])
  @@map("faculty_attendance")
}

// ── Background jobs ───────────────────────────────────────────────────────────
// Platform-wide, not tenant-scoped — a sweep like batch-status or class-reminder
// runs once across ALL tenants per tick, so a single run can't be attributed to
// one tenant. This is the second-ever exception to "every model is tenant-scoped"
// in this schema (the first is Tenant itself) — intentional, not an oversight.
// See apps/api/src/modules/jobs/registry.ts for the code-side job registry this
// pairs with (job label/description/handler live in code; only the admin-editable
// schedule and the run history live here).

enum JobRunStatus {
  running
  success
  failure
}

model JobConfig {
  id              String   @id @default(uuid())
  key             String   @unique
  intervalMinutes Int
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  runs JobRun[]

  @@map("job_configs")
}

model JobRun {
  id            String       @id @default(uuid())
  jobKey        String
  jobConfig     JobConfig    @relation(fields: [jobKey], references: [key])
  status        JobRunStatus @default(running)
  // "scheduler" | "manual" — TS union in registry.ts, not a DB enum (only ever
  // 2 values; a DB enum would need a migration to add a 3rd if that ever changes).
  trigger       String
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  errorMessage  String?
  resultSummary Json?
  triggeredById String?
  triggeredBy   Staff?       @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([jobKey, startedAt])
  @@map("job_runs")
}

// ── Access control ────────────────────────────────────────────────────────────
// Tenant-scoped (unlike JobConfig/JobRun above) — different institutes must be
// able to configure this differently. The set of valid screenKeys lives in
// apps/api/src/modules/permissions/registry.ts; a missing (tenant, role,
// screenKey) row means DENY, not "fall back to a default" — deliberately no
// runtime fallback, unlike NotificationRoutingRule's DEFAULT_ROUTING. Ownership
// scoping (a teacher only seeing their own batches/students/sessions) is a
// separate, untouched concern — this table governs whether a role can reach a
// screen at all, not which rows within it they see.
model PermissionGrant {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  role        StaffRole
  screenKey   String
  canRead     Boolean   @default(false)
  canWrite    Boolean   @default(false)
  canEdit     Boolean   @default(false)
  canDelete   Boolean   @default(false)
  updatedAt   DateTime  @updatedAt
  updatedById String?
  updatedBy   Staff?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, role, screenKey])
  @@map("permission_grants")
}

// ── Government Exam Intelligence ────────────────────────────────────────────
// Global, not tenant-scoped (same reasoning as JobConfig/JobRun above) — the
// same SSC/IBPS/RRB facts apply regardless of which institute is asking.
// Admin write access is still restricted to SITE_TENANT_SLUG's own tenant
// for now (see gov-exams-admin.routes.ts) — same single-tenant-by-convention
// pattern SiteHighlight's content uses, despite this data being
// schema-global rather than carrying a tenantId.

enum GovOrgType {
  ssc
  banking
  railway
  other
}

// Real clock-time scheduling for GovSource/GovJobVacancyPromptTemplate/
// GovCurrentAffairsPromptTemplate — see lib/schedule.ts and
// gov-exams-scheduler.ts. "hourly" needs no further fields; daily/weekly/
// monthly need scheduleTimeOfDay (IST, "HH:MM"); weekly also needs
// scheduleDayOfWeek; monthly also needs scheduleDayOfMonth.
enum GovScheduleFrequency {
  hourly
  daily
  weekly
  monthly
}

enum GovRecruitmentStatus {
  draft
  published
  archived
}

// "manual" = admin-entered, "scraped" = pending step 4's AI extraction
// pipeline — scraped rows land as draft and need admin review before
// publishing, same review-queue idea as any other draft.
enum GovContentSource {
  manual
  scraped
}

model GovRecruitment {
  id                      String   @id @default(uuid())
  category                GovOrgType
  // Plain display text — sourced directly from whatever the extraction/
  // import/admin form provides. No matching, no lookup entity: an
  // open-ended, AI-extracted set of organization names doesn't fit a
  // matched/created directory (see the ADR-style note in the plan this
  // replaced — gov_organizations table + fuzzy matching was fragile for
  // this and added no real value beyond display).
  organization            String?
  title                   String
  slug                    String   @unique
  totalVacancies          Int?
  qualification           String?
  ageMin                  Int?
  ageMax                  Int?
  // e.g. { "obc": 3, "sc_st": 5 } — age relaxation (years) by category
  categoryRelaxations     Json?
  // e.g. { "general": 100, "sc_st": 0 }
  applicationFee          Json?
  // array of { name, vacancyCount, payScale } — collapsed from a separate
  // table; revisit only if eligibility ever needs per-post granularity
  posts                   Json?
  applicationStartDate    DateTime?
  applicationEndDate      DateTime?
  examDate                DateTime?
  officialNotificationUrl String?
  officialWebsiteUrl      String?
  // Where a candidate actually submits their application — distinct from
  // officialNotificationUrl (the PDF/announcement) since many recruitments
  // link those separately (e.g. a "notification.pdf" vs an "apply online"
  // form on a different page).
  applyUrl                String?
  status                  GovRecruitmentStatus @default(draft)
  source                  GovContentSource     @default(manual)
  sourceUrl               String?
  publishedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // ── Rich fields (populated by the manual JSON import — see gov-exams/import —
  // an admin pastes AI-Overview-style search output rather than relying on the
  // scraper/native-search pipeline). All optional: recruitments created through
  // the plain admin form or the scraper never populate these. ──────────────────
  department           String?
  advertisementNumber  String?
  jobLocation          String?
  localLanguageRequirement String?
  requiredExperience   String?
  payScale             String?
  basicPay             String?
  salaryRange          String?
  otherBenefits        String?
  ageAsOnDate          DateTime?
  paymentLastDate      DateTime?
  correctionLastDate   DateTime?
  prelimsDate          DateTime?
  mainsDate            DateTime?
  admitCardDate        DateTime?
  resultDate           DateTime?
  interviewDate        DateTime?
  verificationStatus   String?
  lastVerifiedAt       DateTime?
  summary              String? @db.Text
  whoCanApply          String? @db.Text
  howToApply           String? @db.Text
  importantNote        String? @db.Text
  // string[]
  selectionProcess     Json?
  // string[]
  applicationProcess   Json?
  // string[]
  documentsRequired    Json?
  // string[]
  highlights           Json?
  // { mode, stages: string[], subjects: string[], duration, negativeMarking }
  examPattern          Json?
  // Record<string, number> — vacancy breakdown by reservation category
  postsByCategory      Json?
  // Record<string, number> — vacancy breakdown by state
  postsByState         Json?

  documents GovDocument[]

  @@index([status, category])
  @@index([status, applicationEndDate])
  @@map("gov_recruitments")
}

// Unifies admit cards/results/answer keys/notifications/syllabus into one
// table, distinguished by `type` — they're structurally identical (title +
// release date + a document URL, linked to one recruitment).
enum GovDocumentType {
  admit_card
  result
  answer_key
  notification
  syllabus
}

model GovDocument {
  id            String   @id @default(uuid())
  recruitmentId String
  recruitment   GovRecruitment @relation(fields: [recruitmentId], references: [id])
  type          GovDocumentType
  title         String
  releaseDate   DateTime?
  documentUrl   String?
  source        GovContentSource @default(manual)
  createdAt     DateTime @default(now())

  @@index([recruitmentId, type])
  @@map("gov_documents")
}

enum CurrentAffairCategoryPriority {
  primary
  secondary
}

// Admin-configurable current-affairs categories shown on the public Gov Exam
// Intelligence portal (apps/exam-portal). Global (no tenantId) — same design
// as GovCurrentAffair itself: content is shared, write access is gated to
// SITE_TENANT_SLUG's own admins at the route layer, not by tenant scoping
// here. "key" is the stable slug used in URLs (?category=...), the
// scraper's structured-output schema, and the AI assistant tool — never
// shown to end users directly (labelEn/labelHi are).
model CurrentAffairCategory {
  id           String                        @id @default(uuid())
  key          String                        @unique
  labelEn      String
  labelHi      String
  shortLabelEn String
  shortLabelHi String
  priority     CurrentAffairCategoryPriority @default(primary)
  sortOrder    Int                           @default(0)
  isVisible    Boolean                       @default(true)
  // Exactly one row should have isDefault = true — enforced at the service
  // layer (create/update), not the DB. Used as the scraper's fallback
  // category when AI extraction can't determine one.
  isDefault    Boolean                       @default(false)
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  currentAffairs GovCurrentAffair[]

  @@map("current_affair_categories")
}

model GovCurrentAffair {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  categoryId    String
  category      CurrentAffairCategory @relation(fields: [categoryId], references: [id])
  whatHappened  String
  keyFacts      Json?    // string[]
  whyImportant  String?
  // e.g. { ssc: true, banking: false, railway: true, upsc: false, ... } —
  // boolean flags per the prompt-template extraction shape (see
  // GovCurrentAffairsPromptTemplate). Widened at the app layer from the
  // older free-text-per-key shape; no migration needed, already Json.
  examRelevance Json?
  publishedDate DateTime
  status        GovRecruitmentStatus @default(draft)
  source        GovContentSource     @default(manual)
  sourceUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Rich fields (populated by the prompt-template scraper — see
  // current-affairs-import-mapper.ts). All optional: current affairs
  // created through the plain admin form never populate these. Typed
  // columns cover the frequently-queried essentials; richData carries
  // everything else the extraction shape returns (numbers, people,
  // scheme_or_policy, appointment, award, report_or_index, international,
  // official_links, secondary_sources, subcategory, one_liner, exam_facts,
  // who_should_remember, etc.) rather than expanding the schema for every
  // long-tail field. ──────────────────────────────────────────────────────
  level               String? // "national" | "state" | "union_territory"
  newsStatus          String? // "current" | "upcoming" | "updated" — distinct from `status` (the publish-state field)
  importance          String? // "high" | "medium" | "low"
  organization        String?
  ministry            String?
  state               String?
  eventDate           DateTime?
  verificationStatus  String? // "verified" | "partially_verified" | "unverified"
  richData            Json?

  @@index([status, categoryId, publishedDate])
  @@map("gov_current_affairs")
}

enum GovSourceContentType {
  recruitment
  current_affair
}

// "url" = Firecrawl-scrape one fixed page every sweep. "search" = ask the
// AI Gateway's native web search (the provider searches and reads pages
// on its own infrastructure — no page content ever touches this app) for
// a synthesized, structured answer to searchQuery every sweep. "search"
// is the better fit for staying current without curating exact URLs up
// front, and naturally avoids the "one giant aggregator page" problem
// url-mode sources can hit. Exactly one of url/searchQuery is set,
// matching fetchMode — enforced at the service/validation layer, not the
// DB, same convention as organizationId being conditionally meaningful by
// contentType.
enum GovSourceFetchMode {
  url
  search
}

// Admin-configurable content source, by exam category (step 4). Scraped
// recruitments carry `category` straight from this row and `organization`
// as plain extracted text — no matched/created organization entity.
model GovSource {
  id               String     @id @default(uuid())
  category         GovOrgType
  contentType      GovSourceContentType
  fetchMode        GovSourceFetchMode @default(url)
  label            String
  url              String?
  searchQuery      String?
  enabled          Boolean    @default(true)
  // Independently schedulable per row (see lib/schedule.ts and
  // gov-exams-scheduler.ts) — no bundled "run every source together" job
  // anymore.
  scheduleFrequency  GovScheduleFrequency @default(hourly)
  scheduleTimeOfDay  String? // "HH:MM", IST — required for daily/weekly/monthly
  scheduleDayOfWeek  Int? // 0=Sunday..6=Saturday — weekly only
  scheduleDayOfMonth Int? // 1-31, clamped to the real last day of shorter months — monthly only
  lastScrapedAt    DateTime?
  lastScrapeStatus String? // "success" | "partial" | "error"
  lastScrapeError  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([category, enabled])
  @@map("gov_sources")
}

// Replaces GovSource's "search" fetchMode entirely: one admin-written
// prompt per job-vacancy category (not per-source free-text searchQuery).
// The admin owns the full instruction — the sweep passes it to the AI
// Gateway's native web search as-is, no system-side query-wrapping — and
// the LLM returns the same rich { card, details, content } shape the
// manual JSON-import feature already accepts (see import-mapper.ts,
// reused unchanged for this). One row per GovOrgType, same "row per key"
// pattern as AiModelAssignment.purpose.
model GovJobVacancyPromptTemplate {
  category           GovOrgType @id
  prompt             String     @db.Text
  enabled            Boolean    @default(true)
  scheduleFrequency  GovScheduleFrequency @default(hourly)
  scheduleTimeOfDay  String? // "HH:MM", IST — required for daily/weekly/monthly
  scheduleDayOfWeek  Int? // 0=Sunday..6=Saturday — weekly only
  scheduleDayOfMonth Int? // 1-31, clamped to the real last day of shorter months — monthly only
  lastRunAt          DateTime?
  lastRunStatus      String? // "success" | "partial" | "error"
  lastRunError       String?
  // The web search step's raw answer, cached the moment it succeeds —
  // independent of whether the second (structured-extraction) step that
  // follows it succeeds. A search can cost real, non-trivial provider spend
  // (confirmed: one run burned ~116K input tokens) and take minutes to
  // complete; a bug in extraction alone (schema mismatch, validation
  // failure) shouldn't mean re-buying that same search again just to test a
  // fix. lastSearchAt is separate from lastRunAt: a run can fail at
  // extraction and still have refreshed the cached search just fine.
  lastSearchContent   String?  @db.Text
  lastSearchCitations Json?
  lastSearchAt        DateTime?
  updatedAt          DateTime   @updatedAt

  @@map("gov_job_vacancy_prompt_templates")
}

// One shared prompt covers all categories in a single search — each
// returned item self-tags which exam categories it's relevant to (see
// GovCurrentAffair.examRelevance), rather than running a separate search
// per category. Singleton row, same pattern as GovExamsMeta.id.
model GovCurrentAffairsPromptTemplate {
  id                 String    @id @default("singleton")
  prompt             String    @db.Text
  enabled            Boolean   @default(true)
  // Defaults to a daily 6 AM IST run — a sensible "ready before the day
  // starts" time for a news digest.
  scheduleFrequency  GovScheduleFrequency @default(daily)
  scheduleTimeOfDay  String?   @default("06:00") // "HH:MM", IST
  scheduleDayOfWeek  Int? // 0=Sunday..6=Saturday — weekly only
  scheduleDayOfMonth Int? // 1-31, clamped to the real last day of shorter months — monthly only
  lastRunAt          DateTime?
  lastRunStatus      String? // "success" | "partial" | "error"
  lastRunError       String?
  // See GovJobVacancyPromptTemplate's identical fields for why this is
  // cached separately from the run outcome.
  lastSearchContent   String?  @db.Text
  lastSearchCitations Json?
  lastSearchAt        DateTime?
  updatedAt          DateTime  @updatedAt

  @@map("gov_current_affairs_prompt_template")
}

// ── AI Assistant (chat sessions) ─────────────────────────────────────────────
// Generic, surface-agnostic session/message persistence — shared by every AI
// feature across the product (gov-exams admin assistant today; future admin
// agentic actions and a student-facing doubt-resolver are expected to reuse
// these two tables — see apps/api/src/modules/ai-assistant/). `surface`
// distinguishes which feature a session belongs to; it's a plain String (not
// a DB enum) so a new surface never needs a migration — same reasoning as
// JobRun.trigger. Valid values live in ai-assistant.types.ts, not here.
enum AiAssistantMessageRole {
  user
  assistant
}

model AiAssistantSession {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  // Nullable so a future anonymous/public session (no logged-in staff) can
  // reuse this same table — every session today always has a staffId.
  staffId  String?
  staff    Staff?  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  surface  String // e.g. "gov_exams_admin" — see AssistantSurface in ai-assistant.types.ts

  // Auto-derived from the first question asked in this session (see
  // appendTurn()); null until the first message is posted. No rename
  // endpoint in v1.
  title         String?
  // Denormalized copy of the latest message's createdAt, same "cheap list
  // sorting" cache pattern as GovSource.lastScrapedAt.
  lastMessageAt DateTime?
  // Opaque per-surface context bag for future use — unused/always null for
  // gov_exams_admin today. Plain Json? + comment, same convention as every
  // other JSON field in this schema, no DB-level validation.
  context       Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages AiAssistantMessage[]

  @@index([tenantId, staffId, surface, lastMessageAt])
  @@map("ai_assistant_sessions")
}

model AiAssistantMessage {
  id        String                 @id @default(uuid())
  sessionId String
  session   AiAssistantSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      AiAssistantMessageRole
  content   String @db.Text
  // Assistant-row-only: structured ResponseBlock[] the answer was rendered
  // from (see @amarjit_gts/universal-ai-orchestrator's ResponseBlock).
  // `content` stays the derived markdown string, kept for compatibility;
  // this is the real render source once present. Null for user rows and
  // for any assistant row written before this field existed.
  contentBlocks Json?

  // Set only on role=assistant rows: which user question this answers.
  // Unique because exactly one assistant reply is ever written per question
  // (see appendTurn()).
  replyToId String?             @unique
  replyTo   AiAssistantMessage? @relation("MessageReply", fields: [replyToId], references: [id])
  replyFrom AiAssistantMessage? @relation("MessageReply")

  // Assistant-row-only fields, mirroring AssistantAskResult's shape.
  mechanism String? // "planned" | "reactive" — owned by the SDK's own type, plain String so a future SDK value doesn't need a migration
  toolCalls Json?   // { toolName: string; status: string }[]

  // Assistant-row-only: cost/token summary for this message, denormalized
  // directly from OrchestratorRunResult.usage (already computed — no new
  // AI-core work) for an instant "cost of this message"/"cost per user"
  // (one join to AiAssistantSession.staffId) read with no cross-database
  // query. Null when served from cache (no new AI call was made) or for
  // any assistant row written before this field existed. aiRequestId is
  // the same requestId passed to ai.run() — it correlates this row to its
  // full per-call, per-provider breakdown in @amarjit_gts/universal-ai-
  // database's UsageRecord table (see ADR-002's addendum in
  // universal-ai-platform), which this app never needs to query directly
  // unless that breakdown is ever actually needed.
  aiRequestId      String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  estimatedCostUsd Float?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("ai_assistant_messages")
}

// Local, standalone answer cache backing @amarjit_gts/universal-ai-sdk's
// pluggable CacheStore for the Gov Exams AI Assistant (see
// lib/ai/prisma-cache-store.ts). `key` is a sha256 hash the SDK computes
// itself (normalized question + an opaque freshness stamp we supply) — this
// table never interprets it. Reads filter on expiresAt > now(); an
// expired-but-present row is treated as a miss, not eagerly deleted.
model AiAssistantCacheEntry {
  key       String   @id
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("ai_assistant_cache_entries")
}

// One fixed-id row, upserted — a cheap "has any recruitment/current-affair
// changed" timestamp, used to build the Gov Exams AI Assistant's cache
// freshness stamp (see gov-exams.service.ts's bumpGovExamsDataVersion()).
// Bumping this changes every subsequent cache key downstream, so a stale
// cached answer is never explicitly deleted — it's just never looked up
// again and ages out via AiAssistantCacheEntry's own TTL.
model GovExamsMeta {
  id               String   @id @default("singleton")
  lastDataChangeAt DateTime @default(now())

  @@map("gov_exams_meta")
}

// Platform-wide (no tenantId — matches JobConfig's precedent, not
// NotificationRoutingRule's tenant-scoped one) AI provider/model routing,
// admin-configurable without a redeploy. Provider API keys stay in env
// vars (see lib/env.ts) — this only stores WHICH provider+model serves
// each purpose; institute-os has no encryption-at-rest utility, and
// building one is out of scope (see ADR-007 Addendum 5 in
// universal-ai-platform). Backs PrismaModelConfigProvider (lib/
// aiModelConfigProvider.ts), which implements @amarjit_gts/universal-ai-
// ai-core's ModelConfigProvider interface.
enum AiProviderType {
  openai
  groq
  anthropic
  google
}

// Each purpose maps to an ai-core ModelRegistry logical name — see
// PURPOSE_TO_LOGICAL_NAME in lib/aiModelConfigProvider.ts.
enum AiModelPurpose {
  chat // -> "default-chat"
  reasoning // -> "reasoning-strong" (new; what an important tool's modelHint targets)
  websearch // -> "web-search-chat" (existing ai-core slot name)
  embedding // -> "default-embedding"
}

// Admin-managed catalog of candidate models — enabled/disabled without
// losing the config, same toggle precedent as GovSource.enabled.
model AiModelCatalogEntry {
  id               String              @id @default(uuid())
  provider         AiProviderType
  modelId          String // raw provider model id, e.g. "gpt-4o", "openai/gpt-oss-20b"
  label            String // admin-friendly display name
  fallbackProvider AiProviderType?
  fallbackModelId  String?
  enabled          Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  assignments      AiModelAssignment[]

  @@unique([provider, modelId])
  @@map("ai_model_catalog_entries")
}

// One row per purpose — which catalog entry currently serves it. No row =
// no dynamic override, ai-core's static env-based default keeps serving
// (see PrismaModelConfigProvider.loadEntries()) — zero forced admin
// action before this ships, zero behavior change on day one.
model AiModelAssignment {
  purpose      AiModelPurpose      @id
  modelEntryId String
  modelEntry   AiModelCatalogEntry @relation(fields: [modelEntryId], references: [id])
  updatedAt    DateTime            @updatedAt

  @@map("ai_model_assignments")
}

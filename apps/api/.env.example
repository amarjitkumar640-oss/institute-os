DATABASE_URL="postgresql://institute:institute@localhost:5432/institute_os?schema=public"
PORT=4000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="institute"
S3_SECRET_KEY="institute123"
S3_BUCKET="institute-os"

# Password reset — all optional. Unset means that delivery channel is
# unconfigured; forgot-password requests still succeed (generic response,
# never leaks whether an account exists) but no email/SMS actually goes out
# until these are set. See lib/email.ts / lib/sms.ts.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Base URL of the web portal — used to build the emailed reset link.
WEB_APP_URL="http://localhost:3000"